# Copy to config/.env and fill in. Never commit config/.env.
# The social app and the marketplace proxy API calls to this port
PORT=4000
NODE_ENV=development

# MongoDB connection string (e.g. MongoDB Atlas)
MONGO_URI=
DB=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Email (nodemailer)
MAIL_SERVICE=
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
SMPT_HOST=
SMPT_PORT=
SMPT_PASSWORD=
